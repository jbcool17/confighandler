{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cluster Configuration",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the cluster"
    },
    "location": {
      "type": "string",
      "description": "GCP location for the cluster"
    },
    "network_config": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string",
          "description": "VPC network name"
        },
        "pod_cidr": {
          "type": "string",
          "description": "CIDR range for pods",
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
        }
      },
      "required": ["network", "pod_cidr"]
    },
    "node_pools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the node pool"
          },
          "machine_type": {
            "type": "string",
            "description": "Machine type for nodes"
          }
        },
        "required": ["name", "machine_type"]
      }
    },
    "feature_one": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable feature one"
        }
      }
    }
  },
  "required": ["name", "location"]
}
